<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_pricelist_temp_search_view" model="ir.ui.view">
        <field name="model">product.pricelist.temp</field>
        <field name="arch" type="xml">
            <search>
                <field name="default_code"/>                
            </search>
        </field>
    </record>   

    <record id="product_pricelist_temp_tree_view" model="ir.ui.view">
        <field name="name">product.pricelist.temp.tree</field>
        <field name="model">product.pricelist.temp</field>
        <field name="arch" type="xml">
		<tree string="Lista de precio temporal" >
            <field name="default_code" />
            <field name="pricelist_id" />
            <field name="name" />
            <field name="product_id" />
            <field name="currency_id" />
            <field name="price" />
            <field name="write_date" />            
		</tree>
	    </field>
	</record>

    <record id="action_product_pricelist_temp" model="ir.actions.act_window">
        <field name="name">Lista de precio temporal</field>
        <field name="res_model">product.pricelist.temp</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem action="action_product_pricelist_temp" id="menu_product_pricelist_temp" 
    parent="sale.product_menu_catalog" name="Lista de precio temporal" sequence="300" />

</odoo>